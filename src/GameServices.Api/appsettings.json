{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=gameservices.db"
  },
  "Jwt": {
    "Issuer": "GameServices",
    "Audience": "GameServicesClients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "RateLimit": {
    "AuthRequestsPerMinute": 20
  }
}
