{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=gameservices.db"
  },
  "Jwt": {
    "Issuer": "GameServices",
    "Audience": "GameServicesClients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "RateLimit": {
    "AuthRequestsPerMinute": 20,
    "MapRequestsPerMinute": 120
  },
  "Map": {
    "CacheFolder": "map-cache",
    "CacheDays": 30,
    "GapBetweenRequestsMs": 1500,
    "OverpassUrls": [
      "https://overpass-api.de/api/interpreter",
      "https://overpass.private.coffee/api/interpreter"
    ]
  }
}
